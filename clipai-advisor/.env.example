# ClipAI Advisor - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/clipai_advisor
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=clipai_advisor
POSTGRES_PORT=5432

# AI/LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Default LLM provider: "openai", "grok", "huggingface"
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4

# Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-west1-gcp-free
PINECONE_INDEX_NAME=clipai-knowledge

# Security
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# RAG Configuration
MAX_CONTEXT_LENGTH=4000
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
KNOWLEDGE_BASE_DIR=knowledge-base

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API Configuration
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="ClipAI Advisor"
NEXT_PUBLIC_APP_DESCRIPTION="AI Assistant untuk Agensi Kliping"

# Environment
NODE_ENV=development

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify these for production deployment

# Production Database (Supabase example)
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Production Frontend URL
# ALLOWED_ORIGINS=["https://clipai-advisor.vercel.app","https://your-domain.com"]

# Production Backend URL
# BACKEND_URL=https://clipai-advisor-backend.herokuapp.com

# Security (Production)
# DEBUG=false
# LOG_LEVEL=WARNING

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# ChromaDB (alternative to Pinecone)
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_HTTP_PORT=8001

# Email Service (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Docker Compose overrides
COMPOSE_PROJECT_NAME=clipai-advisor
COMPOSE_FILE=docker-compose.yml

# Hot reload settings
WATCHFILES_FORCE_POLLING=true

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Never commit this file with real values to version control
# 2. Use strong, unique passwords and API keys
# 3. Rotate secrets regularly
# 4. Use different values for development/staging/production
# 5. Consider using a secret management service for production
#
# For more information, see:
# - docs/SETUP.md
# - docs/DEPLOYMENT.md
# - docs/SECURITY.md